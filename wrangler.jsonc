{
  "name": "staken",
  "main": "src/index.js",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/pb", "/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "staken", "database_id": "7a22fedc-6a34-409d-afd8-515f2be7be50" }
  ],
  "vars": { "MIN_DEPOSIT": "100" }
}
